'use client';

import { useEffect, useRef, useState } from 'react';

// Remplace par l'URL publique de ton backend Railway si différente,
// ou définis NEXT_PUBLIC_API_URL dans les variables d'environnement Vercel.
const API_URL = process.env.NEXT_PUBLIC_API_URL || 'https://afroclip-backend-production.up.railway.app';

type JobStatus = 'idle' | 'pending' | 'downloading' | 'analyzing' | 'processing' | 'uploading' | 'done' | 'error';

interface Clip {
  title: string;
  durationSec: number;
  url: string;
}

interface JobState {
  status: JobStatus;
  progress: number;
  error: string | null;
  clips: Clip[];
}

const STATUS_LABELS: Record<JobStatus, string> = {
  idle: '',
  pending: 'Préparation…',
  downloading: 'Récupération de la vidéo…',
  analyzing: 'Analyse de la vidéo…',
  processing: 'Découpage en shorts…',
  uploading: 'Finalisation…',
  done: 'Terminé !',
  error: 'Une erreur est survenue'
};

export default function VideoAnalyzer() {
  const [youtubeUrl, setYoutubeUrl] = useState('');
  const [jobId, setJobId] = useState<string | null>(null);
  const [job, setJob] = useState<JobState>({ status: 'idle', progress: 0, error: null, clips: [] });
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const isRunning = ['pending', 'downloading', 'analyzing', 'processing', 'uploading'].includes(job.status);

  const stopPolling = () => {
    if (pollRef.current) {
      clearInterval(pollRef.current);
      pollRef.current = null;
    }
  };

  useEffect(() => {
    return () => stopPolling(); // nettoyage si le composant se démonte
  }, []);

  const handleAnalyze = async () => {
    if (!youtubeUrl.trim()) return;

    setJob({ status: 'pending', progress: 0, error: null, clips: [] });

    try {
      const res = await fetch(`${API_URL}/api/analyze`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ youtubeUrl: youtubeUrl.trim() })
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Lien YouTube invalide ou erreur serveur');
      }

      const data = await res.json();
      setJobId(data.jobId);
      startPolling(data.jobId);
    } catch (err: any) {
      setJob({ status: 'error', progress: 0, error: err.message, clips: [] });
    }
  };

  const startPolling = (id: string) => {
    stopPolling();
    pollRef.current = setInterval(async () => {
      try {
        const res = await fetch(`${API_URL}/api/analyze/${id}`);
        if (!res.ok) throw new Error('Job introuvable');
        const data: JobState = await res.json();
        setJob(data);

        if (data.status === 'done' || data.status === 'error') {
          stopPolling();
        }
      } catch (err: any) {
        setJob((prev) => ({ ...prev, status: 'error', error: err.message }));
        stopPolling();
      }
    }, 2500);
  };

  const handleReset = () => {
    stopPolling();
    setYoutubeUrl('');
    setJobId(null);
    setJob({ status: 'idle', progress: 0, error: null, clips: [] });
  };

  return (
    <div className="w-full max-w-xl mx-auto bg-white rounded-2xl shadow-md p-6 space-y-5">
      <div>
        <label className="block text-sm font-medium text-gray-700 mb-2">
          Lien de la vidéo YouTube
        </label>
        <input
          type="url"
          value={youtubeUrl}
          onChange={(e) => setYoutubeUrl(e.target.value)}
          placeholder="https://youtube.com/..."
          disabled={isRunning}
          className="w-full rounded-xl border border-gray-200 px-4 py-3 text-sm focus:outline-none focus:ring-2 focus:ring-violet-400 disabled:opacity-60"
        />
      </div>

      {job.status === 'idle' && (
        <button
          onClick={handleAnalyze}
          disabled={!youtubeUrl.trim()}
          className="w-full rounded-xl bg-gradient-to-r from-violet-500 to-orange-400 text-white font-semibold py-3 disabled:opacity-50"
        >
          Analyser la vidéo
        </button>
      )}

      {isRunning && (
        <div className="space-y-2">
          <div className="flex justify-between text-sm text-gray-600">
            <span>{STATUS_LABELS[job.status]}</span>
            <span>{job.progress}%</span>
          </div>
          <div className="w-full h-2 rounded-full bg-gray-100 overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-violet-500 to-orange-400 transition-all duration-500"
              style={{ width: `${job.progress}%` }}
            />
          </div>
        </div>
      )}

      {job.status === 'error' && (
        <div className="text-sm text-red-600 bg-red-50 rounded-xl p-3">
          {job.error || 'Erreur inconnue'}
          <button onClick={handleReset} className="ml-2 underline">
            Réessayer
          </button>
        </div>
      )}

      {job.status === 'done' && (
        <div className="space-y-4">
          <p className="text-sm font-medium text-gray-700">
            {job.clips.length} short{job.clips.length > 1 ? 's' : ''} prêt{job.clips.length > 1 ? 's' : ''} !
          </p>
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {job.clips.map((clip, i) => (
              <div key={i} className="rounded-xl overflow-hidden border border-gray-100 bg-gray-50">
                <video src={clip.url} controls className="w-full aspect-[9/16] object-cover bg-black" />
                <div className="p-2 flex items-center justify-between text-xs text-gray-600">
                  <span>{clip.title}</span>
                  <a href={clip.url} download className="text-violet-600 font-medium">
                    Télécharger
                  </a>
                </div>
              </div>
            ))}
          </div>
          <button
            onClick={handleReset}
            className="w-full rounded-xl border border-gray-200 text-gray-700 font-medium py-3"
          >
            Analyser une autre vidéo
          </button>
        </div>
      )}
    </div>
  );
}
