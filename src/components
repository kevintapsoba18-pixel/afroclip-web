'use client';

import { useEffect, useRef, useState } from 'react';

// Remplace par l'URL publique de ton backend Railway si différente,
// ou définis NEXT_PUBLIC_API_URL dans les variables d'environnement Vercel.
const API_URL = process.env.NEXT_PUBLIC_API_URL || 'https://afroclip-backend-production.up.railway.app';

type JobStatus = 'idle' | 'pending' | 'downloading' | 'analyzing' | 'processing' | 'uploading' | 'done' | 'error';

interface Clip {
  title: string;
  durationSec: number;
  subtitleStyle: string;
  url: string;
}

interface JobState {
  status: JobStatus;
  progress: number;
  error: string | null;
  clips: Clip[];
}

const STATUS_LABELS: Record<JobStatus, string> = {
  idle: '',
  pending: 'Préparation…',
  downloading: 'Récupération de la vidéo…',
  analyzing: 'Analyse de la vidéo…',
  processing: 'Découpage et sous-titrage…',
  uploading: 'Finalisation…',
  done: 'Terminé !',
  error: 'Une erreur est survenue'
};

const DURATIONS = [
  { value: 15, label: '15 s', hint: 'Punchy' },
  { value: 30, label: '30 s', hint: 'Équilibré' },
  { value: 60, label: '60 s', hint: 'Story' }
];

const SUBTITLE_STYLES = [
  { value: 'karaoke', label: 'Karaoké', hint: 'Jaune vibrant', color: '#FFD400' },
  { value: 'neon', label: 'Néon', hint: 'Glow violet', color: '#B15DFF' },
  { value: 'gras-blanc', label: 'Gras Blanc', hint: 'Classique', color: '#FFFFFF' },
  { value: 'pop-orange', label: 'Pop Orange', hint: 'Style Afro', color: '#FF7A00' }
];

export default function VideoAnalyzer() {
  const [youtubeUrl, setYoutubeUrl] = useState('');
  const [clipDuration, setClipDuration] = useState(30);
  const [subtitleStyle, setSubtitleStyle] = useState('karaoke');
  const [job, setJob] = useState<JobState>({ status: 'idle', progress: 0, error: null, clips: [] });
  const pollRef = useRef<ReturnType<typeof setInterval> | null>(null);

  const isRunning = ['pending', 'downloading', 'analyzing', 'processing', 'uploading'].includes(job.status);

  const stopPolling = () => {
    if (pollRef.current) {
      clearInterval(pollRef.current);
      pollRef.current = null;
    }
  };

  useEffect(() => {
    return () => stopPolling();
  }, []);

  const handleAnalyze = async () => {
    if (!youtubeUrl.trim()) return;

    setJob({ status: 'pending', progress: 0, error: null, clips: [] });

    try {
      const res = await fetch(`${API_URL}/api/analyze`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          youtubeUrl: youtubeUrl.trim(),
          clipDuration,
          subtitleStyle
        })
      });

      if (!res.ok) {
        const data = await res.json().catch(() => ({}));
        throw new Error(data.error || 'Lien YouTube invalide ou erreur serveur');
      }

      const data = await res.json();
      startPolling(data.jobId);
    } catch (err: any) {
      setJob({ status: 'error', progress: 0, error: err.message, clips: [] });
    }
  };

  const startPolling = (id: string) => {
    stopPolling();
    pollRef.current = setInterval(async () => {
      try {
        const res = await fetch(`${API_URL}/api/analyze/${id}`);
        if (!res.ok) throw new Error('Job introuvable');
        const data: JobState = await res.json();
        setJob(data);

        if (data.status === 'done' || data.status === 'error') {
          stopPolling();
        }
      } catch (err: any) {
        setJob((prev) => ({ ...prev, status: 'error', error: err.message }));
        stopPolling();
      }
    }, 2500);
  };

  const handleReset = () => {
    stopPolling();
    setYoutubeUrl('');
    setJob({ status: 'idle', progress: 0, error: null, clips: [] });
  };

  return (
    <div className="w-full max-w-xl mx-auto bg-[#14121f] rounded-3xl p-6 space-y-6 text-white">
      {/* Lien YouTube */}
      <div className="rounded-2xl bg-[#1c1930] px-4 py-3 flex items-center gap-3">
        <span className="text-violet-400">▶</span>
        <input
          type="url"
          value={youtubeUrl}
          onChange={(e) => setYoutubeUrl(e.target.value)}
          placeholder="Colle le lien YouTube ici..."
          disabled={isRunning}
          className="flex-1 bg-transparent text-sm placeholder-gray-500 focus:outline-none disabled:opacity-60"
        />
      </div>

      {/* Durée du clip */}
      <div>
        <p className="text-xs tracking-wide text-gray-400 mb-2">DURÉE DU CLIP</p>
        <div className="grid grid-cols-3 gap-3">
          {DURATIONS.map((d) => (
            <button
              key={d.value}
              type="button"
              disabled={isRunning}
              onClick={() => setClipDuration(d.value)}
              className={`rounded-xl py-3 text-center border transition disabled:opacity-60 ${
                clipDuration === d.value
                  ? 'border-violet-500 bg-violet-500/10'
                  : 'border-white/10 bg-[#1c1930]'
              }`}
            >
              <div className="font-semibold">{d.label}</div>
              <div className="text-xs text-gray-400">{d.hint}</div>
            </button>
          ))}
        </div>
      </div>

      {/* Style de sous-titres */}
      <div>
        <p className="text-xs tracking-wide text-gray-400 mb-2">STYLE DE SOUS-TITRES</p>
        <div className="grid grid-cols-2 gap-3">
          {SUBTITLE_STYLES.map((s) => (
            <button
              key={s.value}
              type="button"
              disabled={isRunning}
              onClick={() => setSubtitleStyle(s.value)}
              className={`rounded-xl py-3 px-4 text-left border transition disabled:opacity-60 ${
                subtitleStyle === s.value
                  ? 'border-violet-500 bg-violet-500/10'
                  : 'border-white/10 bg-[#1c1930]'
              }`}
            >
              <div className="font-semibold" style={{ color: s.color }}>{s.label}</div>
              <div className="text-xs text-gray-400">{s.hint}</div>
            </button>
          ))}
        </div>
      </div>

      {/* Bouton générer / progression */}
      {job.status === 'idle' && (
        <button
          onClick={handleAnalyze}
          disabled={!youtubeUrl.trim()}
          className="w-full rounded-2xl bg-gradient-to-r from-violet-500 to-pink-500 text-white font-semibold py-4 disabled:opacity-50"
        >
          ✨ Générer les Shorts IA
        </button>
      )}

      {isRunning && (
        <div className="space-y-2">
          <div className="flex justify-between text-sm text-gray-300">
            <span>{STATUS_LABELS[job.status]}</span>
            <span>{job.progress}%</span>
          </div>
          <div className="w-full h-2 rounded-full bg-white/10 overflow-hidden">
            <div
              className="h-full bg-gradient-to-r from-violet-500 to-pink-500 transition-all duration-500"
              style={{ width: `${job.progress}%` }}
            />
          </div>
        </div>
      )}

      {job.status === 'error' && (
        <div className="text-sm text-red-400 bg-red-500/10 rounded-xl p-3">
          {job.error || 'Erreur inconnue'}
          <button onClick={handleReset} className="ml-2 underline">
            Réessayer
          </button>
        </div>
      )}

      {job.status === 'done' && (
        <div className="space-y-4">
          <p className="text-sm font-medium text-gray-200">
            {job.clips.length} short{job.clips.length > 1 ? 's' : ''} prêt{job.clips.length > 1 ? 's' : ''} !
          </p>
          <div className="grid grid-cols-2 sm:grid-cols-3 gap-3">
            {job.clips.map((clip, i) => (
              <div key={i} className="rounded-xl overflow-hidden border border-white/10 bg-[#1c1930]">
                <video src={clip.url} controls className="w-full aspect-[9/16] object-cover bg-black" />
                <div className="p-2 flex items-center justify-between text-xs text-gray-300">
                  <span>{clip.title}</span>
                  <a href={clip.url} download className="text-violet-400 font-medium">
                    Télécharger
                  </a>
                </div>
              </div>
            ))}
          </div>
          <button
            onClick={handleReset}
            className="w-full rounded-2xl border border-white/15 text-gray-200 font-medium py-3"
          >
            Analyser une autre vidéo
          </button>
        </div>
      )}
    </div>
  );
}
